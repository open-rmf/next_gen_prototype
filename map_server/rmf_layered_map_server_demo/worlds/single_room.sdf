<?xml version="1.0"?>
<sdf version="1.7">
  <world name="single_room">
    <physics name="3ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="left_wall">
      <static>true</static>
      <pose>-9.75 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 16 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 16 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="right_wall">
      <static>true</static>
      <pose>9.75 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 16 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 16 1</size></box></geometry>
          <material><ambient>0.05 0.35 0.8 1</ambient><diffuse>0.05 0.35 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="bottom_wall">
      <static>true</static>
      <pose>0 -7.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.5 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="top_wall">
      <static>true</static>
      <pose>0 7.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.5 1</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
