<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmf_path_server_demo</name>
  <version>0.0.1</version>
  <description>Web dashboard and launch tools for RMF path server demo.</description>
  <maintainer email="arjoc@intrinsic.ai">Arjo Chakravarty</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rmf_prototype_msgs</exec_depend>
  <exec_depend>rmf_next_gen_reservation_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rmf_mock_robot_sim</exec_depend>
  <exec_depend>rmf_path_server</exec_depend>
  <exec_depend>rmf_plan_executor</exec_depend>
  <exec_depend>rmf_simple_destination_server</exec_depend>
  <exec_depend>rmf_reservation_destination_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
