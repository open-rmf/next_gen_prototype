<?xml version="1.0"?>
<sdf version="1.8">
  <world name="corridor_docks">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      3x8 corridor (x in [-2.5, 5.5], y in [-1.5, 1.5]) with 6 protruding 1x1m dock alcoves:
      - dock_north_1: x in [-1.5, -0.5], y in [1.5, 2.5] (center: -1.0, 2.0)
      - dock_north_2: x in [ 0.5,  1.5], y in [1.5, 2.5] (center:  1.0, 2.0)
      - dock_north_3: x in [ 2.5,  3.5], y in [1.5, 2.5] (center:  3.0, 2.0)
      - dock_south_1: x in [-1.5, -0.5], y in [-2.5, -1.5] (center: -1.0, -2.0)
      - dock_south_2: x in [ 0.5,  1.5], y in [-2.5, -1.5] (center:  1.0, -2.0)
      - dock_south_3: x in [ 2.5,  3.5], y in [-2.5, -1.5] (center:  3.0, -2.0)
    -->
    <model name="corridor_docks_walls">
      <static>true</static>

      <!-- West and East end walls -->
      <link name="west_wall">
        <pose>-2.6 0.0 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 3.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.4 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="east_wall">
        <pose>5.6 0.0 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 3.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.4 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- North corridor wall segments between alcoves -->
      <link name="north_wall_1">
        <pose>-2.0 1.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="north_wall_2">
        <pose>0.0 1.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="north_wall_3">
        <pose>2.0 1.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="north_wall_4">
        <pose>4.5 1.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- North dock 1 alcove (center: -1.0, 2.0) -->
      <link name="dock_north_1_left">
        <pose>-1.6 2.1 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="dock_north_1_right">
        <pose>-0.4 2.1 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="dock_north_1_back">
        <pose>-1.0 2.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- North dock 2 alcove (center: 1.0, 2.0) -->
      <link name="dock_north_2_left">
        <pose>0.4 2.1 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="dock_north_2_right">
        <pose>1.6 2.1 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
