          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="dock_north_3_back">
        <pose>3.0 2.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South corridor wall segments between alcoves -->
      <link name="south_wall_1">
        <pose>-2.0 -1.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="south_wall_2">
        <pose>0.0 -1.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="south_wall_3">
        <pose>2.0 -1.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="south_wall_4">
        <pose>4.5 -1.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South dock 1 alcove (center: -1.0, -2.0) -->
      <link name="dock_south_1_left">
        <pose>-1.6 -2.1 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="dock_south_1_right">
        <pose>-0.4 -2.1 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="dock_south_1_back">
        <pose>-1.0 -2.6 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South dock 2 alcove (center: 1.0, -2.0) -->
      <link name="dock_south_2_left">
        <pose>0.4 -2.1 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="dock_south_2_right">
        <pose>1.6 -2.1 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
