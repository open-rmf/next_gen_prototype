        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- North dock 3 alcove (center: 3.0, 2.0) -->
      <link name="dock_north_3_left">
        <pose>2.4 2.1 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 1.5</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="dock_north_3_right">
