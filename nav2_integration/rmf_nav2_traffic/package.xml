<?xml version="1.0"?>
<package format="3">
  <name>rmf_nav2_traffic</name>
  <version>0.1.0</version>
  <description>BehaviorTree.CPP and rclcpp implementation of Next Gen RMF traffic adapter for Nav2</description>
  <maintainer email="arjoc@intrinsic.ai">Arjo Chakravarty</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>behaviortree_cpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>navigation2</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rmf_prototype_msgs</depend>
  <depend>spatio_temporal_partition_layer</depend>
  <depend>std_msgs</depend>
