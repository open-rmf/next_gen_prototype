<?xml version="1.0"?>
<package format="3">
  <name>rmf_nav2_traffic</name>
  <version>0.1.0</version>
  <description>Python nav2_simple_commander implementation of Next Gen RMF traffic adapter for Nav2</description>
  <maintainer email="arjoc@intrinsic.ai">Arjo Chakravarty</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav2_simple_commander</depend>
  <depend>nav_msgs</depend>
  <depend>navigation2</depend>
  <depend>rclpy</depend>
  <depend>rmf_prototype_msgs</depend>
  <depend>spatio_temporal_partition_layer</depend>
  <depend>std_msgs</depend>
  <depend>unique_identifier_msgs</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
